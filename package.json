{
  "name": "pilot-daily-decisions",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && tsx --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:v2",
    "db:generate": "drizzle-kit generate",
    "migrate:d1": "node scripts/migrate-d1-to-supabase.mjs",
    "invite": "node scripts/invite-user.mjs",
    "dev:v2": "vite --config examples/syndy-v2/vite.config.mjs",
    "build:v2": "vite build --config examples/syndy-v2/vite.config.mjs",
    "preview:v2": "vite preview --config examples/syndy-v2/vite.config.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.2",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vinext": "^1.0.0-beta.11",
    "vite": "^8.3.0",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
